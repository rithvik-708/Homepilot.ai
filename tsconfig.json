{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/mcp-server/src/**/*",
    "apps/mcp-server/tests/**/*",
    "packages/mcp-streamable-http/src/**/*"
  ]
}
